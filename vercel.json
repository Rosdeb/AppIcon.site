{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "api/[...route].mjs": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "appicon.site" }],
      "destination": "https://www.appicon.site/:path*",
      "permanent": true
    },
    { "source": "/website/blog-index.html", "destination": "/blog", "permanent": true },
    { "source": "/website/blog-ios-icon-sizes.html", "destination": "/blog/ios-app-icon-sizes", "permanent": true },
    { "source": "/website/blog-android-icon-guide.html", "destination": "/blog/android-adaptive-icons", "permanent": true },
    { "source": "/website/blog-app-icon-design-tips.html", "destination": "/blog/app-icon-design-tips", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/faq.html", "destination": "/faq", "permanent": true },
    { "source": "/how-it-works.html", "destination": "/how-it-works", "permanent": true },
    { "source": "/privacy-policy.html", "destination": "/privacy-policy", "permanent": true },
    { "source": "/terms-of-service.html", "destination": "/terms-of-service", "permanent": true }
  ],
  "rewrites": [
    {"source": "/tools", "destination": "/website/tools/index.html"},
    {"source": "/tools/image-cropper", "destination": "/website/tools/image-cropper.html"},
    {"source": "/tools/image-resizer", "destination": "/website/tools/image-resizer.html"},
    {"source": "/tools/image-converter", "destination": "/website/tools/image-converter.html"},
    {"source": "/tools/image-compressor", "destination": "/website/tools/image-compressor.html"},
    {"source": "/tools/crop-resize-convert", "destination": "/website/tools/crop-resize-convert.html"},
    {
      "source": "/api/:path*",
      "destination": "/api/[...route]"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/blog",
      "destination": "/website/blog-index.html"
    },
    {
      "source": "/blog/ios-app-icon-sizes",
      "destination": "/website/blog-ios-icon-sizes.html"
    },
    {
      "source": "/blog/android-adaptive-icons",
      "destination": "/website/blog-android-icon-guide.html"
    },
    {
      "source": "/blog/app-icon-design-tips",
      "destination": "/website/blog-app-icon-design-tips.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/how-it-works.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service.html"
    },
    {
      "source": "/android-icon-generator",
      "destination": "/website/android-icon-generator.html"
    },
    {
      "source": "/app-icon-generator",
      "destination": "/website/app-icon-generator.html"
    },
    {
      "source": "/app-icon-generator-free",
      "destination": "/website/app-icon-generator-free.html"
    },
    {
      "source": "/",
      "destination": "/website/index.html"
    }
  ]
}
