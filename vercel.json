      "permanent": true
    },
    {
      "source": "/terms-of-service.html",
      "destination": "/terms-of-service",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/tools",
      "destination": "/website/tools/index.html"
    },
    {
      "source": "/tools/image-cropper",
      "destination": "/website/tools/image-cropper.html"
    },
    {
