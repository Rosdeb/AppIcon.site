{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "api/[...route].mjs": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "appicon.site"
        }
      ],
      "destination": "https://www.appicon.site/:path*",
      "permanent": true
    },
    {
      "source": "/app-icon-generator-free",
      "destination": "/app-icon-generator",
      "permanent": true
    },
    {
      "source": "/website/blog-index.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/website/blog-ios-icon-sizes.html",
      "destination": "/blog/ios-app-icon-sizes",
      "permanent": true
    },
    {
      "source": "/website/blog-android-icon-guide.html",
      "destination": "/blog/android-adaptive-icons",
      "permanent": true
    },
    {
      "source": "/website/blog-app-icon-design-tips.html",
      "destination": "/blog/app-icon-design-tips",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/how-it-works.html",
      "destination": "/how-it-works",
      "permanent": true
    },
    {
      "source": "/privacy-policy.html",
